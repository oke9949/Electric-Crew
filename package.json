{
  "name": "electric-crew-app",
  "private": true,
  "version": "10.0.3",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false && tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --lib ES2022,DOM --skipLibCheck api/ai.ts api/ai-provider.ts",
    "test:ai-provider": "node --experimental-strip-types --test api/ai-provider.test.ts",
    "test:ios-pwa": "node --experimental-strip-types --test tests/ios-install.test.ts tests/pwa-shell.test.mjs",
    "check": "pnpm typecheck && pnpm build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0",
    "@supabase/supabase-js": "2.112.3",
    "leaflet": "1.9.4",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@types/leaflet": "1.9.22",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "supabase": "2.115.0",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
